{
    "name": "aleqcodes/dd-maintenance",
    "description": "DD Maintenance WordPress plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "doctrine/instantiator": "^1.5",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload-dev": {
        "psr-4": {
            "DDMaintenance\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:unit": "phpunit --configuration phpunit.xml --testsuite unit",
        "test:integration": "phpunit --configuration phpunit.xml --testsuite integration",
        "test:smoke": "phpunit --configuration phpunit.xml --testsuite smoke",
        "phpstan": "phpstan analyse --configuration=phpstan.neon",
        "phpcs": "phpcs --standard=phpcs.xml"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "7.4"
        }
    }
}
