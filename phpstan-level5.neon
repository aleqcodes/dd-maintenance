parameters:
    level: 5
    paths:
        - includes/class-dd-maintenance-observability.php
        - includes/class-dd-maintenance-admin-page-data.php
        - includes/class-dd-maintenance-restore-mu-loader.php
    scanFiles:
        - includes/class-dd-maintenance-settings-repository.php
        - includes/class-dd-maintenance-s3.php
        - includes/class-dd-maintenance-config.php
        - includes/class-dd-maintenance-restore.php
        - includes/class-dd-maintenance.php
    stubFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    bootstrapFiles:
        - tests/bootstrap.php
    ignoreErrors:
        -
            message: '#^Function (?:add_filter|current_user_can|get_bloginfo|get_transient|is_user_logged_in|sanitize_title|size_format|wp_json_encode|wp_mkdir_p|wp_next_scheduled|wp_normalize_path) not found\.$#'
    reportUnmatchedIgnoredErrors: true
